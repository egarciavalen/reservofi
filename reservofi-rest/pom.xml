<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.uoc.reservofi</groupId>
        <artifactId>reservofi</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>reservofi-rest</artifactId>

    <name>reservofi-rest</name>
    <description>Módulo centrado en la creación de la API REST</description>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!-- Configuración del swagger -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.0</version>
        </dependency>

        <!-- Dependencia módulo lib -->
        <dependency>
            <groupId>com.uoc.reservofi</groupId>
            <artifactId>reservofi-lib</artifactId>
            <version>${project.version}</version>
        </dependency>

    </dependencies>

</project>